[Unit]
Description=MQTT Sensor Data Collector Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/yuanyi-claw2/Sensor_data_collecter
ExecStart=/home/yuanyi-claw2/Sensor_data_collecter/venv/bin/python3 -m sensor_collector.main --env-file /home/yuanyi-claw2/Sensor_data_collecter/.env
Restart=always
RestartSec=5
User=yuanyi-claw2
Group=yuanyi-claw2

[Install]
WantedBy=multi-user.target
